# ---------------------------------------------------------------------------
# SatQuery AI backend — environment configuration
# Copy this file to .env and adjust values as needed.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_NAME=SatQuery AI
APP_VERSION=1.0.0

HOST=0.0.0.0
PORT=8000

# cpu | cuda
MODEL_DEVICE=cpu

# Run all ML/geospatial features in deterministic mock mode regardless of
# whether the heavy optional dependencies (torch, transformers, rasterio...)
# are installed. Useful for demos and CI. Set to false once real models are
# wired up via MODEL_DEVICE / checkpoint paths.
MOCK_INFERENCE=true

UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
RESULT_DIR=data/results
SAMPLE_DIR=data/samples
CHECKPOINT_DIR=models

# Comma-separated list of allowed origins for CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SQLite file used for history/analysis persistence
HISTORY_DB_PATH=data/history.db

# Upload constraints
MAX_UPLOAD_SIZE_MB=200
MAX_FILES_PER_UPLOAD=4

# Optional: path to a fine-tuned remote-sensing VLM checkpoint (LoRA adapter
# or full model). Leave blank to use the mock/baseline implementation.
VLM_CHECKPOINT_PATH=
